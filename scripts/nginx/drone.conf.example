# Drone CI 反代模板 —— 复制为 <你的CI域名>.conf 放到 /www/server/panel/vhost/nginx/
# 例：ci.example.com.conf，然后把 DNS 解析指向本机；域名属敏感信息不入库。
# Gitee OAuth 应用：
#   主页 URL  http://ci.example.com
#   回调地址  http://ci.example.com/login     （必须与 DRONE_SERVER_HOST 完全一致）
server {
    listen 80;
    server_name ci.example.com;   # ← 改成你的 CI 域名

    # Drone 前端是 SPA，需要转发 WebSocket（构建日志实时输出）
    location / {
        proxy_pass http://127.0.0.1:30080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 600s;
    }

    access_log /www/wwwlogs/ci.example.com.log;
    error_log  /www/wwwlogs/ci.example.com.error.log;
}
