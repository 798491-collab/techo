#!/bin/bash
# PySite 五站管理脚本（随项目版本管理）
# 用法：./pysite {start|stop|restart|status|logs} [站点名]
# 站点名：nanjing | hefei | xuzhou | wuxi | hangzhou
SITES='nanjing hefei xuzhou wuxi hangzhou'
PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ACTION=$1
TARGET=$2

case $ACTION in
  start|stop|restart)
    if [ -n "$TARGET" ]; then
      systemctl $ACTION pysite@$TARGET.service
    else
      for s in $SITES; do systemctl $ACTION pysite@$s.service; done
    fi ;;
  status)
    for s in $SITES; do printf '%-10s ' $s; systemctl is-active pysite@$s.service; done ;;
  logs)
    tail -f "$PROJECT_DIR/${TARGET:-nanjing}/runtime/logs/site.log" ;;
  *)
    echo "用法: $0 {start|stop|restart|status|logs} [nanjing|hefei|xuzhou|wuxi|hangzhou]" ;;
esac
