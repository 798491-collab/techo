[Unit]
Description=PySite %i (FastAPI standalone)
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/pysite/%i
ExecStartPre=+/bin/mkdir -p /www/wwwroot/pysite/%i/storage/logs /www/wwwroot/pysite/%i/storage/cache /www/wwwroot/pysite/%i/storage/temp /www/wwwroot/pysite/%i/storage/sessions /www/wwwroot/pysite/%i/storage/uploads
ExecStart=/www/wwwroot/pysite/venv/bin/python scripts/serve.py
Restart=always
RestartSec=3
StandardOutput=append:/www/wwwroot/pysite/%i/storage/logs/service.log
StandardError=append:/www/wwwroot/pysite/%i/storage/logs/service.log

[Install]
WantedBy=multi-user.target
