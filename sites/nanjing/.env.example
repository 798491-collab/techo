# 站点基础配置（唯一进 Git 的配置文件）
# 站点内容信息（名称/联系方式/SEO 等）存数据库 Setting 表，在管理后台维护
# 密钥真实值只放 .env（不进 Git），不要填在本文件

# --- 应用 ---
key=nanjing
port=8101
admin_user=admin

# --- 存储（唯一持久化目录 storage，容器只挂这一个卷）---
db_path=storage/site.db
cache_dir=storage/cache
upload_dir=storage/uploads
theme_dir=themes
log_dir=storage/logs
tmp_dir=storage/temp
session_dir=storage/sessions

# 密钥占位（真实值只放 .env）
SECRET_KEY=
ADMIN_PASSWORD=
